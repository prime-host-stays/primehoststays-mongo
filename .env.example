# Ops (root) user created by the Mongo image, lives in `admin` db.
MONGO_INITDB_ROOT_USERNAME=change-me
MONGO_INITDB_ROOT_PASSWORD=change-me

# Per-API users created by docker-entrypoint-initdb.d/001-init-phs.js on first boot.
# They live in the `phs` database (authSource=phs).
PHS_COM_API_USERNAME=phs_com
PHS_COM_API_PASSWORD=change-me
PHS_ADMIN_API_USERNAME=phs_admin
PHS_ADMIN_API_PASSWORD=change-me